# ==============================================================================
# Corpora and everything derived from them. All rebuildable, none belongs in git.
# This is ~3.6 GB: dataset_v5 alone is 904 MB and speech_corpus is 1.2 GB.
# ==============================================================================
*.npz
*.npy
dataset/
dataset_*/
noise_bank/
speech_corpus/
corpus_cache/
cache/
logs/
.kaggle-outputs/
*.wav
*.flac
*.mp3
*.ogg

# The noise-bank inventory is 247 KB of CSV naming every clip, its class and its
# duration. The audio is 0.5 GB, the index is what makes stratified sampling
# reproducible, so the index is tracked and the clips it points at are not.
noise_bank_v2/*
!noise_bank_v2/index.csv

# ==============================================================================
# Credentials. The notebook reads its Kaggle key from the environment; kaggle.json
# and the session transcript dumps are local only.
# ==============================================================================
session-ses_*.md
kaggle.json
.env
.env.*
!.env.example
*.pem
*.key
*_rsa
credentials.json

# ==============================================================================
# Model weights: the experiments are reproducible from the code, so only the two
# checkpoints the documentation actually references are tracked.
# ==============================================================================
*.flax
!best_v3_50k.flax
!best_50k_kws_model.flax

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/
scratch/
tmp/
*.log
*.tmp
*.bak

# ==============================================================================
# OS / editor
# ==============================================================================
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp
